{
  // Type-checks the package's own JavaScript source via JSDoc (no build step, no output).
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    "module": "node16",
    "target": "ES2022"
  },
  "include": ["src/**/*.js", "src/**/*.d.ts", "test/**/*"]
}
